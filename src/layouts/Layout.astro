---
import "../styles/styles.css";
import { Font, Image } from "astro:assets";
import nomnomnami from "../assets/images/nomnomnami_badge.gif";
import blamensir from "../assets/images/blamensir-badge.png";
import reigenmoe from "../assets/images/reigenmoe-badge.gif";
import Navbar from "../components/Navbar.astro";
---

<html lang="en">
  <head>
    <Font cssVariable="--font-pixelated-elegance" />
    <Font cssVariable="--font-super-pixel" />
    <Font cssVariable="--font-pixelify-sans" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Potat's Place</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script>
      import "../scripts/sparkles.js";
    </script>
    <script>
      import "../scripts/navbar.js";
    </script>
  </head>
  <body>
    <header class="rainbow-border">
      <h1 class="sparkles-wrapper"><a href="/">Potat's Place</a></h1>
    </header>
    <div class="wrapper">
      <Navbar />
      <slot />
    </div>
  </body>
</html>
